{
  "name": "@teunlao/code-consolidator",
  "version": "0.12.0",
  "private": false,
  "description": "A modern dark-themed UI for code consolidation and documentation. Easily select files from your project and generate PDF, Markdown, or ZIP documentation.",
  "keywords": [
    "code",
    "documentation",
    "pdf",
    "markdown",
    "zip",
    "consolidator",
    "dark-theme",
    "ui",
    "viewer",
    "ai",
    "chatgpt",
    "openai",
    "claude",
    "cloud"
  ],
  "author": "teunlao (teunlao@gmail.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teunlao/code-consolidator.git",
    "directory": "packages/web"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "next build && tsc -p tsconfig.bin.json",
    "start": "next start",
    "lint": "next lint",
    "build:bin": "tsc -p tsconfig.bin.json",
    "clean-next-cache": "rm -rf .next/cache",
    "before-publish": "pnpm run build",
    "publish-package": "pnpm run before-publish && pnpm run clean-next-cache && pnpm publish --access public"
  },
  "files": ["dist", ".next", "next.config.js", "package.json"],
  "bin": {
    "cc-start": "./dist/bin/start.js"
  },
  "devDependencies": {
    "@types/react-syntax-highlighter": "^15.5.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.0.4",
    "@radix-ui/react-dialog": "1.0.5",
    "@radix-ui/react-dropdown-menu": "2.0.6",
    "@radix-ui/react-label": "2.0.2",
    "@radix-ui/react-select": "2.0.0",
    "@radix-ui/react-slot": "1.0.2",
    "@radix-ui/react-switch": "1.0.3",
    "@radix-ui/react-tabs": "1.0.4",
    "@radix-ui/react-toast": "1.1.5",
    "@radix-ui/react-tooltip": "1.0.7",
    "@types/archiver": "6.0.3",
    "@types/node": "20.8.10",
    "@types/pdfkit": "0.13.4",
    "@types/react": "18.2.35",
    "@types/react-dom": "18.2.14",
    "@types/uuid": "9.0.7",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.16",
    "class-variance-authority": "0.7.0",
    "clsx": "2.0.0",
    "lucide-react": "0.290.0",
    "next": "15.1.6",
    "pdfkit": "0.15.0",
    "postcss": "8.4.31",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-syntax-highlighter": "15.5.0",
    "tailwind-merge": "1.14.0",
    "tailwindcss": "3.3.0",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.2.2",
    "uuid": "9.0.1",
    "zustand": "^5.0.3"
  }
}
