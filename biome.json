{
  "$schema": "https://biomejs.dev/schemas/1.9.2/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "defaultBranch": "release",
    "useIgnoreFile": true
  },
  "css": {
    "linter": {
      "enabled": true
    },
    "parser": {
      "cssModules": true
    },
    "assists": {
      "enabled": true
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "files": {
    "ignoreUnknown": false,
    "ignore": []
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "ignore": ["**/dist/**", "**/*.spec.ts", "**/babel*.js"],
    "rules": {
      "complexity": {
        "useArrowFunction": "off",
        "noForEach": "off",
        "noStaticOnlyClass": "off",
        "noBannedTypes": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noParameterAssign": "off",
        "useNodejsImportProtocol": "off",
        "noInferrableTypes": "info"
      },
      "correctness": {
        "noUnknownProperty": "off",
        "noChildrenProp": "off",
        "useExhaustiveDependencies": "off",
        "useImportExtensions": "off"
      },
      "performance": {
        "noAccumulatingSpread": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off",
        "noDangerouslySetInnerHtmlWithChildren": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noShorthandPropertyOverrides": "off",
        "noThenProperty": "off",
        "noConfusingVoidType": "off",
        "noImplicitAnyLet": "error",
        "noExplicitAny": "off",
        "useIsArray": "error"
      },
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "lineWidth": 120,
      "quoteStyle": "single"
    }
  }
}
